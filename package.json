{
  "name": "@guillemservera/vue-drawer",
  "version": "0.2.3",
  "description": "A headless, unstyled and behaviorally opinionated drawer primitive for Vue 3 with gestures, snap points, nested drawers and zero runtime dependencies.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "author": "Guillem Servera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillemservera/vue-drawer.git"
  },
  "bugs": {
    "url": "https://github.com/guillemservera/vue-drawer/issues"
  },
  "homepage": "https://github.com/guillemservera/vue-drawer#readme",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "publint": "0.3.24",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^2.2.12"
  },
  "keywords": [
    "vue",
    "vue3",
    "drawer",
    "bottom-sheet",
    "sheet",
    "modal",
    "headless",
    "unstyled",
    "gestures",
    "snap-points",
    "nested-drawers"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:playground": "pnpm --filter @vue-drawer/playground dev",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint",
    "pack:dry": "npm pack --dry-run",
    "ci": "pnpm typecheck && pnpm test && pnpm build && pnpm publint && pnpm pack:dry",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm publint"
  }
}
