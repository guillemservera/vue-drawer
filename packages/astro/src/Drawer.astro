---
import type { HTMLAttributes } from 'astro/types'
// Relative path on purpose: this file ships as source and must only reach this package's built files.
import '../dist/style.css'

type Props = HTMLAttributes<'dialog'> & {
	/** Edge the drawer slides in from. Default `'bottom'`. */
	direction?: 'top' | 'bottom' | 'left' | 'right'
	/** `false`: Escape, backdrop click and drag do not close it; `close()` and `[data-drawer-close]` still do. Default `true`. */
	dismissible?: boolean
	/** vue's `snapPoints`, least to most visible: fractions of the viewport (`0.5`) or lengths (`'160px'`, `'18rem'`). */
	snapPoints?: (number | string)[]
	/** The snap point it opens at, one of `snapPoints`. Default: the first. */
	activeSnapPoint?: number | string
	/** Snap point index from which the backdrop shows. Default: the last. */
	fadeFromIndex?: number
	/** Every release moves at most one snap point. Default `false`. */
	snapToSequentialPoint?: boolean
}

// The drawer's own props belong to the custom element; everything else (aria-label, aria-labelledby, class...) to the sheet.
const { id, open, direction, dismissible, snapPoints, activeSnapPoint, fadeFromIndex, snapToSequentialPoint, ...attrs } = Astro.props
// Sidebars get no handle (they are dragged from anywhere); a top sheet's handle sits at its bottom edge.
const handleFirst = !direction || direction === 'bottom'
// Astro drops `false` attributes, so non-dismissible must render the string "false".
---

<astro-drawer
	id={id}
	open={open}
	direction={handleFirst ? undefined : direction}
	dismissible={dismissible === false ? 'false' : undefined}
	snap-points={snapPoints?.join(',')}
	active-snap-point={activeSnapPoint}
	fade-from-index={fadeFromIndex}
	snap-to-sequential-point={snapToSequentialPoint}
>
	<dialog {...attrs}>
		{handleFirst && <div data-drawer-handle></div>}
		<slot />
		{direction === 'top' && <div data-drawer-handle></div>}
	</dialog>
</astro-drawer>

<script>
	import '../dist/index.js'
</script>
