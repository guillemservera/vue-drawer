---
import Drawer from '@guillemservera/astro-drawer/Drawer.astro'
import DemoLayout from '../../layouts/DemoLayout.astro'
---

<DemoLayout title="Snap points">
	<p>Drag between snap points: a slow drag lands on the nearest one, a flick moves to the next one (a hard flick skips to the end), and dragging below the first snap point dismisses. The last active snap point is shown below each button.</p>
	<button class="tap" id="open-snap" data-drawer-open="#snap">Fractions <small>0.3, 0.6, 0.92 · backdrop from the last</small></button>
	<button class="tap" id="open-fade" data-drawer-open="#fade">Lengths and fade <small>160px, 0.55, 0.92 · backdrop from index 1</small></button>
	<button class="tap" id="open-seq" data-drawer-open="#seq">Sequential, non-dismissible <small>0.3, 0.6, 0.92 · one snap point per release</small></button>
	<button class="tap" id="open-right" data-drawer-open="#right">Right sidebar <small>0.4, 0.85</small></button>
	<button class="tap" id="open-top" data-drawer-open="#top">Top sheet <small>0.3, 0.7</small></button>
	<button class="tap" id="open-left" data-drawer-open="#left">Left sidebar <small>0.4, 0.85</small></button>

	<Drawer id="snap" snapPoints={[0.3, 0.6, 0.92]} aria-labelledby="snap-title">
		<h2 id="snap-title">Fractions</h2>
		<p>Active: <output>0.3</output></p>
		<button class="tap" data-drawer-close>Close</button>
		{Array.from({ length: 30 }, (_, i) => <p>Row {i + 1}: scrolls only at the top snap point, like vue-drawer.</p>)}
	</Drawer>
	<Drawer id="fade" snapPoints={['160px', 0.55, 0.92]} fadeFromIndex={1} aria-labelledby="fade-title">
		<h2 id="fade-title">Lengths and fade</h2>
		<p>Active: <output>160px</output>. The backdrop shows from 0.55.</p>
		<button class="tap" data-drawer-close>Close</button>
	</Drawer>
	<Drawer id="seq" snapPoints={[0.3, 0.6, 0.92]} snapToSequentialPoint dismissible={false} aria-labelledby="seq-title">
		<h2 id="seq-title">Sequential, non-dismissible</h2>
		<p>Active: <output>0.3</output>. Only the button closes it.</p>
		<button class="tap" data-drawer-close>Close</button>
	</Drawer>
	<Drawer id="right" direction="right" snapPoints={[0.4, 0.85]} aria-labelledby="right-title">
		<h2 id="right-title">Right sidebar</h2>
		<p>Active: <output>0.4</output>. Drag left to widen, right to narrow or close.</p>
		<button class="tap" data-drawer-close>Close</button>
	</Drawer>
	<Drawer id="top" direction="top" snapPoints={[0.3, 0.7]} aria-labelledby="top-title">
		<h2 id="top-title">Top sheet</h2>
		<p>Active: <output>0.3</output>. Drag down to grow, up to shrink or close.</p>
		<button class="tap" data-drawer-close>Close</button>
	</Drawer>
	<Drawer id="left" direction="left" snapPoints={[0.4, 0.85]} aria-labelledby="left-title">
		<h2 id="left-title">Left sidebar</h2>
		<p>Active: <output>0.4</output>. Drag right to widen, left to narrow or close.</p>
		<button class="tap" data-drawer-close>Close</button>
	</Drawer>
</DemoLayout>

<script>
	for (const drawer of document.querySelectorAll('astro-drawer')) {
		drawer.addEventListener('snap-point-change', (event) => {
			drawer.querySelector('output')!.value = String((event as CustomEvent).detail)
		})
	}
</script>
