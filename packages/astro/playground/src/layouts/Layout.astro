---
import { ClientRouter } from 'astro:transitions'

const { title } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<ClientRouter />
		<style is:global>
			#open { position: fixed; top: 1rem; right: 1rem; }
		</style>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<slot />
			{Array.from({ length: 60 }, (_, i) => <p>Filler paragraph {i + 1} so the page scrolls.</p>)}
		</main>
	</body>
</html>
